    "ink": { "$type": "color", "$value": "#4a4238" },
    "muted": { "$type": "color", "$value": "#6e6456", "$description": "升级后达到 WCAG 2.2 AA 级对比度 4.7:1（原 #8a8072 为 3.2:1 偏弱）" },
    "line": { "$type": "color", "$value": "#e7dfcf" },
